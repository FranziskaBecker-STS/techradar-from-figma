{
  "name": "syzygy-techradar-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "node scripts/browser-check.mjs",
    "test:hover": "node --test scripts/radar-hover-check.mjs",
    "test:select": "node --test scripts/technology-select-check.mjs",
    "test:topic": "node --test scripts/topic-select-check.mjs",
    "test:keyboard": "node --test scripts/keyboard-flow-check.mjs",
    "test:details": "node --test scripts/detail-content-check.mjs",
    "test:logos": "node --test scripts/radar-logo-check.mjs",
    "test": "node --test scripts/radar-hover-check.mjs scripts/technology-select-check.mjs scripts/detail-content-check.mjs scripts/radar-logo-check.mjs scripts/topic-select-check.mjs scripts/keyboard-flow-check.mjs",
    "build:pages": "tsc -b && vite build --mode github-pages && node scripts/prepare-pages.mjs",
    "test:pages": "node --test scripts/pages-check.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "@playwright/test": "^1.56.0"
  }
}
